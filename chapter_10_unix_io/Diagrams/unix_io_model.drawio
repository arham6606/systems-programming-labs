        <mxCell id="dj5EgWcsISmf0JabgW7E-40" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;font style=&quot;font-size: 16px;&quot;&gt;&lt;strong&gt;&lt;span class=&quot;&quot;&gt;Unix abstracts all I/O devices through a common file descriptor interface.&quot;&lt;/span&gt;&lt;/strong&gt;&lt;/font&gt;" vertex="1">
          <mxGeometry height="30" width="580" x="90" y="10" as="geometry" />
        </mxCell>
        <mxCell id="dj5EgWcsISmf0JabgW7E-44" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="&lt;div align=&quot;left&quot;&gt;&lt;li&gt;&lt;p class=&quot;ds-markdown-paragraph&quot;&gt;&lt;font style=&quot;font-size: 16px;&quot;&gt;&lt;b&gt;&lt;span class=&quot;&quot;&gt;Application calls &lt;/span&gt;&lt;code&gt;open(&quot;/file&quot;)&lt;/code&gt;&lt;span class=&quot;&quot;&gt; → Kernel returns &lt;/span&gt;&lt;span class=&quot;&quot;&gt;FD=3&lt;/span&gt;&lt;/b&gt;&lt;/font&gt;&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p class=&quot;ds-markdown-paragraph&quot;&gt;&lt;font style=&quot;font-size: 16px;&quot;&gt;&lt;b&gt;&lt;span class=&quot;&quot;&gt;Application calls &lt;/span&gt;&lt;code&gt;read(fd=3, ...)&lt;/code&gt;&lt;span class=&quot;&quot;&gt; → Kernel uses FD to look up the device&lt;/span&gt;&lt;/b&gt;&lt;/font&gt;&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p class=&quot;ds-markdown-paragraph&quot;&gt;&lt;font style=&quot;font-size: 16px;&quot;&gt;&lt;b&gt;&lt;span class=&quot;&quot;&gt;Kernel routes the request to the correct driver (Disk/Terminal/Socket)&lt;/span&gt;&lt;/b&gt;&lt;/font&gt;&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p class=&quot;ds-markdown-paragraph&quot;&gt;&lt;font style=&quot;font-size: 16px;&quot;&gt;&lt;b&gt;&lt;span class=&quot;&quot;&gt;Data flows back to the application—&lt;/span&gt;&lt;span class=&quot;&quot;&gt;all without the app knowing the hardware details&lt;/span&gt;&lt;/b&gt;&lt;/font&gt;&lt;/p&gt;&lt;/li&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="150" width="590" x="130" y="860" as="geometry" />
        </mxCell>
